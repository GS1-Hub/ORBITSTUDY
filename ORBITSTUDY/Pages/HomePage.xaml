<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="ORBITSTUDY.Pages.HomePage"
             Title="HomePage"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="#080B14">

    <Grid HorizontalOptions="Fill"
          RowDefinitions="Auto,*,Auto"
          Margin="14">

        <Grid Grid.Row="0"
              ColumnDefinitions="*, Auto"
              ColumnSpacing="20">

            <VerticalStackLayout Grid.Column="0" 
                                 HorizontalOptions="Start" 
                                 Spacing="4"
                                 VerticalOptions="Center">
                <Label Text="XP"
                       TextColor="DodgerBlue"
                       FontAttributes="Bold"
                       HorizontalOptions="Start"/>
                <ProgressBar Progress="1"
                             WidthRequest="250"
                             HeightRequest="6"
                             ProgressColor="DodgerBlue"/>
                <Label Text="{Binding Level}"
                       FontSize="10"
                       TextColor="LightYellow"
                       FontAttributes="Bold"
                       HorizontalOptions="Start"/>
            </VerticalStackLayout>

            <ImageButton Grid.Column="1"
                         x:Name="btnSettings"
                         Source="settings_icon.png"
                         HorizontalOptions="End"
                         VerticalOptions="Center"
                         Clicked="btnSettings_Clicked"
                         CornerRadius="9"/>
        </Grid>

        <Grid Grid.Row="1"
          HorizontalOptions="Center"
          VerticalOptions="Center">

            <Image Source="orbit_semfundo.png"
           HorizontalOptions="Center"
           VerticalOptions="Start"/>

            <Label Text="ORBIT"
                   FontSize="50"
                   FontAttributes="Bold"
                   TextColor="#5B8CFF"
                   HorizontalOptions="Center"
                   VerticalOptions="Start"
                   ZIndex="1"
                   Margin="0,10,0,0"/>

        </Grid>
        <Grid   ColumnDefinitions="*,*,*"
                HeightRequest="60"
                Grid.Row="2">
            <ImageButton Source="trophy_icon.png"
                 Grid.Column="0"
                 x:Name="btnAnchiments"
                 HorizontalOptions="Center"
                 HeightRequest="20"
                 CornerRadius="20"
                 Clicked="btnAnchiments_Clicked"/>
            <ImageButton Source="play_icon.png"
                             Grid.Column="1"
                             x:Name="btnStart"
                             HorizontalOptions="Center"
                             HeightRequest="20"
                             CornerRadius="20"
                             Clicked="btnStart_Clicked"/>
            <ImageButton Source="info_icon.png"
                         x:Name="btnInfo"
                          Grid.Column="2"
                          HorizontalOptions="Center"
                          HeightRequest="20"
                          CornerRadius="20"
                         Clicked="btnInfo_Clicked"/>
        </Grid>
    </Grid>
</ContentPage>