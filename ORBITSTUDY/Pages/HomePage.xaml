<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ORBITSTUDY.Pages.HomePage"
             Title="HomePage"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="#080B14">

    <Grid RowDefinitions="Auto, *, Auto"
          RowSpacing="20"
          Margin="20">

        <Grid Grid.Row="0"
              ColumnDefinitions="*, Auto"
              ColumnSpacing="15"
              VerticalOptions="Center">

            <VerticalStackLayout Grid.Column="0" 
                                 Spacing="6"
                                 VerticalOptions="Center">
                <Grid>
                    <Label Text="PROGRESSO"
                           TextColor="#8A99AD"
                           FontSize="11"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"/>
                    <Label Text="{Binding Level, StringFormat='Nível {0}'}"
                           FontSize="11"
                           TextColor="LightYellow"
                           FontAttributes="Bold"
                           HorizontalOptions="End"/>
                </Grid>

                <ProgressBar Progress="{Binding XpProgress}"
                             HeightRequest="8"
                             ProgressColor="DodgerBlue"
                             BackgroundColor="#1A2238"/>
            </VerticalStackLayout>

            <ImageButton Grid.Column="1"
                         x:Name="btnSettings"
                         Source="settings_icon.png"
                         HeightRequest="36"
                         WidthRequest="36"
                         BackgroundColor="#1A2238"
                         CornerRadius="18"
                         Padding="8"
                         VerticalOptions="Center"
                         Clicked="btnSettings_Clicked"/>
        </Grid>

        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="15">
            <Image Source="nave_icon.png"
                   x:Name="imgCenter"
                   HeightRequest="220"
                   WidthRequest="220"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <Grid Grid.Row="2"
              ColumnDefinitions="*, 1.2*, *"
              ColumnSpacing="15"
              HeightRequest="70"
              VerticalOptions="Center">

            <ImageButton Source="trophy_icon.png"
                         Grid.Column="0"
                         x:Name="btnAnchiments"
                         BackgroundColor="#161C2E"
                         HeightRequest="55"
                         WidthRequest="55"
                         CornerRadius="28"
                         Padding="15"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Clicked="btnAnchiments_Clicked"/>

            <ImageButton Source="play_icon.png"
             Grid.Column="1"
             x:Name="btnStart"
             BackgroundColor="White"
             HeightRequest="65"
             WidthRequest="65"
             CornerRadius="32"
             Padding="18"
             HorizontalOptions="Center"
             VerticalOptions="Center"
             Clicked="btnStart_Clicked"/>

            <ImageButton Source="info_icon.png"
                         Grid.Column="2"
                         x:Name="btnInfo"
                         BackgroundColor="#161C2E"
                         HeightRequest="55"
                         WidthRequest="55"
                         CornerRadius="28"
                         Padding="15"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Clicked="btnInfo_Clicked"/>
        </Grid>

    </Grid>
</ContentPage>