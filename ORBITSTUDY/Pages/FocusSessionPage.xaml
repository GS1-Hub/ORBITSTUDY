<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="ORBITSTUDY.Pages.FocusSessionPage"
             Title="Viagem Espacial"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="#080B14">

    <Grid>
        <skia:SKCanvasView x:Name="CanvasView" PaintSurface="OnCanvasViewPaintSurface" />

        <Grid RowDefinitions="Auto, *, Auto"
              Margin="24">

            <HorizontalStackLayout Grid.Row="0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center">
                <Button Text="✕ Abortar Viagem"
                        TextColor="#FF5555"
                        BackgroundColor="Transparent"
                        FontSize="14"
                        FontAttributes="Bold"
                        Clicked="BtnAbort_Clicked"/>
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="1"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20">

                <Image Source="nave_icon.png"
                       HeightRequest="140"
                       WidthRequest="140"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"/>

                <Label Text="A navegar pelo hiperespaço..."
                       TextColor="#8A99AD"
                       FontSize="16"
                       HorizontalTextAlignment="Center"/>

                <Label x:Name="LblTimer"
                       Text="00:00:00"
                       TextColor="White"
                       FontSize="48"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2"
                                 Spacing="10">
                <Button x:Name="BtnFinish"
                        Text="Chegar ao Destino (Terminar)"
                        TextColor="White"
                        BackgroundColor="DodgerBlue"
                        HeightRequest="50"
                        CornerRadius="25"
                        FontAttributes="Bold"
                        Clicked="BtnFinish_Clicked"/>
            </VerticalStackLayout>

        </Grid>
    </Grid>
</ContentPage>