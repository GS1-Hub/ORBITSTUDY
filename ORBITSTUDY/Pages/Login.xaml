<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ORBITSTUDY.Pages.Login"
             Title="Login"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#080B14">

    <Grid Padding="32" VerticalOptions="Center" HorizontalOptions="Center">
        <VerticalStackLayout Spacing="24" MaximumWidthRequest="400">

            <VerticalStackLayout Spacing="4" HorizontalOptions="Start">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="Welcome to ORBIT"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Image Source="nave_icon.png"
                           WidthRequest="24"
                           HeightRequest="24"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="Your best friend to study"          
                           FontSize="14"
                           TextColor="#8E99AF"/>
                    <Image Source="star_icon.png"
                           WidthRequest="14"
                           HeightRequest="14"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Username"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#5B8CFF"/>
                    <Border BackgroundColor="#0D1322"
                            Stroke="#1F293D"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,4">
                        <Entry Placeholder="Enter your username"
                               PlaceholderColor="#4B5563"
                               TextColor="White"
                               FontSize="14"
                               BackgroundColor="Transparent"
                               x:Name="txt_username"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Password"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#5B8CFF"/>
                    <Border BackgroundColor="#0D1322"
                            Stroke="#1F293D"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,4">
                        <Entry Placeholder="Enter your password"
                               PlaceholderColor="#4B5563"
                               TextColor="White"
                               FontSize="14"
                               IsPassword="True"
                               BackgroundColor="Transparent"
                               x:Name="txt_password"/>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12" Margin="0,8,0,0">
                <Button Text="Sign In"
                        BackgroundColor="#5B8CFF"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="48"
                        x:Name="btnSignin"
                        Clicked="btnSignin_Clicked"/>

                <Button Text="Create Account"
                        BackgroundColor="Transparent"
                        TextColor="#5B8CFF"
                        BorderColor="#5B8CFF"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="48"
                        x:Name="btnRegister"
                        Clicked="btnRegister_Clicked"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Grid>
</ContentPage>